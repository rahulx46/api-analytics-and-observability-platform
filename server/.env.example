# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=replace_with_local_postgres_password

# RabbitMQ Configuration
RABBITMQ_URL=amqp://api_user:replace_with_rabbitmq_password@localhost:5672/api_monitoring
RABBITMQ_QUEUE=api_hits

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# API Keys (comma-separated for initial setup)
VALID_API_KEYS=replace_with_test_key_1,replace_with_test_key_2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100